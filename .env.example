# ─── PostgreSQL (OpenFGA datastore) ───────────────────────────────
POSTGRES_USER=openfga
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=openfga

# ─── OpenFGA ──────────────────────────────────────────────────────
# HTTP API the console (and clients) talk to
OPENFGA_API_URL=http://openfga:8080
# For local (non-Docker) runs of the console/seed, use:
# OPENFGA_API_URL=http://localhost:8080
#
# OpenFGA supports several auth methods. For a small self-hosted setup a
# pre-shared key is simplest. Leave OPENFGA_AUTHN_METHOD=none for local demo,
# switch to preshared for anything exposed.
OPENFGA_AUTHN_METHOD=none
# When OPENFGA_AUTHN_METHOD=preshared, set a comma-separated key list:
OPENFGA_PRESHARED_KEYS=change-me-openfga-key
# The console/seed send this as the bearer token (must match one of the keys above):
OPENFGA_API_TOKEN=change-me-openfga-key

# ─── PocketBase (console admin auth) ──────────────────────────────
POCKETBASE_URL=http://pocketbase:8090
# For local (non-Docker) runs of the console:
# POCKETBASE_URL=http://localhost:8090

# ─── Console ──────────────────────────────────────────────────────
# Secret used to sign the console's own session cookie
CONSOLE_SESSION_SECRET=change-me-session-secret
NODE_ENV=development
